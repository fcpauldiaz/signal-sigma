SIGNAL_SIGMA_EMAIL=your_email@example.com
SIGNAL_SIGMA_PASSWORD=your_password_here
SIGNAL_SIGMA_REFRESH_TOKEN=
# Legacy fallback (optional if paper/live ids are set)
SIGNAL_SIGMA_PORTFOLIO_ID=
SIGNAL_SIGMA_PAPER_PORTFOLIO_ID=a8c3cd4c-3c66-4af2-b8bb-1d343399a2f4
SIGNAL_SIGMA_LIVE_PORTFOLIO_ID=5a9db3b0-8942-4c41-9d59-77c3ad2e7a07
SIGNAL_SIGMA_PERSIST_TOKENS=true
# Comma-separated strategy IDs for ownership-price checks (Millennium Alpha, Momentum, Vision)
SIGNAL_SIGMA_STRATEGY_IDS=f835ece6-e41a-4d8a-ac3f-c5468088149a,5e3f1ff3-5bdb-4bcf-8baf-e69652056e3d,efd217dd-da21-48fd-8442-d5abe3664c08

# Default mode for CLI when --mode is omitted. Desk can switch paper/live at runtime.
TRADING_MODE=paper
# Opt-in order placement (desk toggles persist to data/execution.json)
PAPER_EXECUTION_ENABLED=false
LIVE_EXECUTION_ENABLED=false
TRADIER_LIVE_ACCOUNT_ID=
TRADIER_LIVE_API_KEY=
TRADIER_PAPER_ACCOUNT_ID=
TRADIER_PAPER_API_KEY=

# Charles Schwab Trader API (read-only desk view). Tokens persist to data/schwab-tokens.json.
# Register an Individual Trader app at https://developer.schwab.com
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the callback registered on the Schwab app (HTTPS required).
SCHWAB_CALLBACK_URL=https://127.0.0.1:3000/api/schwab/callback
# Optional: encrypted account hash from GET /accounts/accountNumbers
SCHWAB_ACCOUNT_HASH=
# Optional: plain account number; used to pick the hash when SCHWAB_ACCOUNT_HASH is unset
SCHWAB_ACCOUNT_NUMBER=

# Coolify scheduled tasks (not in-app node-cron). Keep ENABLE_SCHEDULER=false.
# Wednesday 10:00 AM EDT (14:00 UTC) — Coolify: wednesday-rebalance
REBALANCE_SCHEDULE=0 14 * * 3
# Wednesday hourly 10:00 AM–4:00 PM EDT — Coolify: wednesday-place-orders
ORDER_SCHEDULE=0 14-20 * * 3
ENABLE_SCHEDULER=false
HEADLESS=true

UI_PORT=3000
# Desk password for rebalance / place / Ready / execution toggles.
# Sessions are HttpOnly cookies stored in data/admin-sessions.json (90 days).
# Persist /app/data (or cwd/data) across Coolify redeploys so you stay logged in.
ADMIN_PASSWORD=
